{
  "name": "combat-crocs",
  "version": "1.0.0",
  "description": "Worms-style turn-based strategy game featuring crocodiles in an Orlando setting",
  "main": "src/game.js",
  "scripts": {
    "prepare": "cp node_modules/phaser/dist/phaser.min.js .",
    "build": "NODE_ENV=production webpack --mode=production",
    "build:dev": "webpack --mode=development",
    "start": "webpack serve --mode=development",
    "dev": "npm run build:dev && npm start",
    "start:fallback": "lsof -ti:3001 | xargs kill -9 2>/dev/null || true && python3 -m http.server 3001"
  },
  "keywords": [
    "game",
    "phaser",
    "worms",
    "strategy",
    "turn-based"
  ],
  "author": "Combat Crocs Team",
  "license": "MIT",
  "dependencies": {
    "phaser": "^3.60.8"
  },
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@babel/preset-env": "^7.28.5",
    "babel-loader": "^10.0.0",
    "webpack": "^5.103.0",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.2"
  }
}
